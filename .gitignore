# Secrets — AGENTS.md §5.1: never commit a filled .env, only .env.example
.env
.env.*
!.env.example

# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
dist/
build/
coverage/
.turbo/
*.tsbuildinfo

# Test and user data — AGENTS.md §10: never commit a real user document.
# A Playwright trace embeds DOM snapshots, a screencast and the captured network of the run.
# playwright.config.ts writes under tmp/, but these are Playwright's defaults and come back
# as soon as a run happens outside that config or with --output.
tmp/
test-results/
playwright-report/
.playwright-artifacts-*/
*.log

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
